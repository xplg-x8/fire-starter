# ============================================================================
# xplg-service — per-server configuration. Same compose files everywhere;
# THIS file is what makes a server a master / worker / edge.
# ============================================================================
#   docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d
#   podman compose -f docker-compose.yml -f docker-compose.traefik.yml \
#                  -f docker-compose.podman.yml up -d
# ============================================================================

COMPOSE_PROJECT_NAME=xplg-service
TZ=UTC

#XPLG_IMAGE=docker.xplg.com/xplg:8.2.0-Main
XPLG_IMAGE=xplghub/images:8.2.0-Main

# ── Identity ────────────────────────────────────────────────────────────────
# THIS server's alias. MULTI-SERVER MUST SET IT — two servers sharing an alias
# collide on node names and the cluster join is refused.
SELF_ALIAS=xplg-seed-1

# Roles on THIS server. master | server (ui+listener+processor) |
# server-additional (processor+processor-1) | ui | listener | processor |
# processor-1. Traefik is NOT a profile — add docker-compose.traefik.yml.
COMPOSE_PROFILES=master,server

# ── Alias → IP map ──────────────────────────────────────────────────────────
# THE seed definition. Identical on every server, and used by every container
# including Traefik. There is no second, edge-specific map.
XPLG_SEED_1_IP=127.0.0.1
XPLG_SEED_2_IP=127.0.0.1
XPLG_SEED_3_IP=127.0.0.1
XPLG_SEED_4_IP=127.0.0.1
#XPLG_SEED_5_IP=127.0.0.
#XPLG_SEED_6_IP=127.0.0.

# ── Storage ─────────────────────────────────────────────────────────────────
# LOCAL disk only — Ignite raft/RocksDB/Chronicle live here, never on NFS.
# Shared extConf. Point at an NFSv4 host mountpoint for a real cluster;
# omit to keep it under XPLG_BASE_HOST_PATH (single-server dev).

# ── Resources ───────────────────────────────────────────────────────────────
XPLG_MEMORY_LIMIT=8g
XPLG_MEMORY_RESERVATION=4g
XPLG_PROCESSOR_MEMORY_LIMIT=16g
XPLG_PROCESSOR_MEMORY_RESERVATION=8g
XPLG_PROCESSOR_CPU_LIMIT=4


# Where workers reach the master to fetch/run jobs (the master publishes it too).
XPLG_JOBS_MASTER_CONN=http://xplg-seed-1:30308/logeye


# ════════════════════════════════════════════════════════════════════════════
# Traefik edge (docker-compose.traefik.yml)
# ════════════════════════════════════════════════════════════════════════════
# Pool membership comes from TWO sources, unioned:
#   1. the lists below — declarative, works across servers without discovery
#   2. conf/registry/*.node — each node registers itself on start; drop a file
#      by hand to add one. Reconciled into the route table every 10s.
# Unset lists = SELF_ALIAS, i.e. everything routes to THIS server (correct for
# single-server). Multi-server example:
#XPLG_TRAEFIK_MASTER_SERVERS=xplg-seed-1
#XPLG_TRAEFIK_UI_SERVERS=xplg-seed-1,xplg-seed-2
#XPLG_TRAEFIK_LISTENER_SERVERS=xplg-seed-3
#XPLG_TRAEFIK_PROCESSOR_SERVERS=xplg-seed-3,xplg-seed-4
#XPLG_TRAEFIK_PROCESSOR_1_SERVERS=xplg-seed-4

# Watched file-provider folder + node registry. Defaults sit next to these
# compose files; point the registry at a shared/NFS dir for cluster-wide
# registration.
#XPLG_TRAEFIK_DYNAMIC_PATH=./conf/dynamic
#XPLG_TRAEFIK_REGISTRY_PATH=./conf/registry
#XPLG_TRAEFIK_SSL_PATH=./conf/ssl

# Entry ports. 80/443 -> ui pool, 30303/30443 -> master pool.
#XPLG_TRAEFIK_HTTP_PORT=80
#XPLG_TRAEFIK_HTTPS_PORT=443
#XPLG_TRAEFIK_MASTER_HTTP_PORT=30303
#XPLG_TRAEFIK_MASTER_HTTPS_PORT=30443

# ── Local podman-machine (WSL) notes ────────────────────────────────────────
# Bind paths must be LINUX paths INSIDE the machine, not Windows paths:
XPLG_BASE_HOST_PATH=/home/xplg/xplg-service
XPLG_SHARED_HOST_PATH=/home/xplg/xplg-service/home/data
# Rootless cannot bind 80/443 unless:
#   sudo sysctl -w net.ipv4.ip_unprivileged_port_start=80
# Otherwise shift the entry ports:
#XPLG_TRAEFIK_HTTP_PORT=8080
#XPLG_TRAEFIK_HTTPS_PORT=8443
